# ── automint config — copy to automint.env and fill in ──────────────────────
# The ONLY secrets here are the Telegram token (a chat credential, not a wallet)
# and the owner chat id. Private keys are NEVER in this file — they live as
# individual files in KEYS_DIR, created by you.

# From @BotFather: /newbot, then paste the token it gives you.
TELEGRAM_TOKEN=123456:ABC-your-bot-token

# Your personal Telegram numeric id. Message @userinfobot to get it. The bot
# obeys ONLY this chat, so a stolen token still cannot make it spend.
OWNER_CHAT_ID=

# Where wallet key files live. Each file = one private key, chmod 600, created
# by you or by /newwallet. Nothing here is ever sent over chat.
KEYS_DIR=./keys

# Hard spend ceiling PER WALLET, in native token. No chat command can raise it —
# that is the point. Set it to a little above the most expensive mint you expect.
MAX_SPEND_ETH=0.05

# State the bot persists between restarts.
DROPS_FILE=./drops.json
SETTINGS_FILE=./settings.json

# Optional: private RPCs, comma-separated, per chain. A fast/private endpoint is
# the single biggest factor in a contested mint. Free Alchemy keys work well.
# RPC_ROBINHOOD=https://...
# RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_ETHEREUM=https://...
